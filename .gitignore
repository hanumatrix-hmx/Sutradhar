*.tsbuildinfo

# Packaged build artifacts — generated, not source
*.tar.gz
*.tgz

# Mirrored into packages/sutradhar/ at build time from the real root-level copy —
# see scripts/build-bundle.mjs. Never hand-edit this one.
packages/sutradhar/AGENT_SETUP.md

# Runtime data written by the app itself, not source
.sutradhar-storage/
.sutradhar-cli/

# Per-session lock file (sessionId/pid/timestamp) — was accidentally committed in the initial
# commit and has been pure session churn ever since, with no legitimate reason to be tracked.
# Untracked below via `git rm --cached`; this stops it from ever showing as a dirty-tree change
# again (it was the one thing blocking `npm publish`'s prepublishOnly gate on a genuinely clean
# working tree).
.claude/scheduled_tasks.lock

# Scratch/manual comparison tooling — installs its own deps outside the pnpm workspace
tools/engine-comparison/scratch-npm/
tools/engine-comparison/results/

# Benchmark run artifacts — generated reports, not source
tools/webbench/results/
