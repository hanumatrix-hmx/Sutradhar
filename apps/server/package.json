{
  "name": "@sutradhar/server",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Sutradhar Platform REST API gateway server, HTTP route handlers, and application controller entrypoint",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --ext .ts",
    "start": "node dist/index.js",
    "dev": "tsc -w",
    "test": "vitest run --globals",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@sutradhar/contracts": "workspace:*",
    "@sutradhar/capability": "workspace:*",
    "@sutradhar/utils": "workspace:*",
    "@sutradhar/config": "workspace:*",
    "@sutradhar/observability": "workspace:*",
    "@sutradhar/events": "workspace:*",
    "@sutradhar/browser": "workspace:*",
    "@sutradhar/llm": "workspace:*",
    "@sutradhar/memory": "workspace:*",
    "@sutradhar/agent": "workspace:*",
    "@sutradhar/workflow": "workspace:*",
    "@sutradhar/storage": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.4.2"
  }
}
