# PinchTab environment configuration.
# Copy this file to `.env` (at the repo root) and fill in what you need.
# Shell-set environment variables always take precedence over this file.

# ---- LLM provider ----------------------------------------------------------
# Option A: OpenRouter (cloud, 200+ models incl. capable free ones).
# Get a key at https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-...

# Option B: local Ollama (default; no key needed). Make sure `ollama serve` is
# running on http://localhost:11434 and the model below is pulled.
PINCHTAB_MODEL=qwen3.5:9b

# Option C: any OpenAI-compatible endpoint (your own gateway, LiteLLM, etc.).
# PINCHTAB_LLM_BASE=http://localhost:4000/v1
# PINCHTAB_LLM_KEY=

# ---- Browser ---------------------------------------------------------------
# Path to a Chrome/Edge executable if auto-detection fails.
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# ---- Server ----------------------------------------------------------------
# PORT=8081
