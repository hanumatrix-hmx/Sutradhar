{
  "name": "@sutradhar/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Terminal CLI for driving the Sutradhar browser engine directly — nav/snap/click/type/press/text/screenshot/audit/compare/doctor.",
  "main": "./dist/index.js",
  "bin": {
    "sutradhar": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --ext .ts",
    "test": "vitest run --globals",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@sutradhar/browser": "workspace:*",
    "@sutradhar/capability-runtime": "workspace:*",
    "@sutradhar/contracts": "workspace:*",
    "@sutradhar/observability": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "5.4.2"
  }
}
