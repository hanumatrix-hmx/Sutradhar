{
  "name": "@pinchtab/frontend",
  "version": "0.1.0",
  "description": "PinchTab Web & Desktop Client Application Frontend",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@pinchtab/contracts": "workspace:*",
    "@pinchtab/sdk": "workspace:*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "jsdom": "^24.0.0",
    "typescript": "5.4.2",
    "vite": "^5.1.6",
    "vitest": "^1.4.0"
  }
}
