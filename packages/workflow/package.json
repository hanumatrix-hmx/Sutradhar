{
  "name": "@pinchtab/workflow",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Multi-agent workflow orchestration, DAG node graphs, step routing, and task graph execution engine for PinchTab",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --ext .ts",
    "test": "vitest run --globals",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@pinchtab/contracts": "workspace:*",
    "@pinchtab/capability": "workspace:*",
    "@pinchtab/utils": "workspace:*",
    "@pinchtab/config": "workspace:*",
    "@pinchtab/observability": "workspace:*",
    "@pinchtab/events": "workspace:*",
    "@pinchtab/browser": "workspace:*",
    "@pinchtab/llm": "workspace:*",
    "@pinchtab/memory": "workspace:*",
    "@pinchtab/agent": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.4.2"
  }
}
