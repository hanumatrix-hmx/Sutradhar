{
  "name": "@sutradhar/browser",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Headless browser automation engine, stealth launch wrapper, and DOM snapshot generator for Sutradhar",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --ext .ts",
    "test": "vitest run --globals",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@sutradhar/contracts": "workspace:*",
    "@sutradhar/capability": "workspace:*",
    "@sutradhar/utils": "workspace:*",
    "@sutradhar/config": "workspace:*",
    "@sutradhar/observability": "workspace:*",
    "@sutradhar/events": "workspace:*",
    "puppeteer-core": "^25.5.0"
  },
  "devDependencies": {
    "typescript": "5.4.2"
  }
}
