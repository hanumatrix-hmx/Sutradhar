{
  "name": "sutradhar",
  "version": "0.4.1",
  "type": "module",
  "description": "AI-agent browser automation, in one package: an MCP server (npx sutradhar-mcp), a terminal CLI (npx sutradhar), and an embeddable Node SDK (import { launch } from 'sutradhar'). Drives a real Chrome/Edge with dual DOM+accessibility-tree grounding built for AI agents.",
  "homepage": "https://github.com/hanumatrix-hmx/Sutradhar#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hanumatrix-hmx/Sutradhar.git"
  },
  "keywords": ["browser-automation", "mcp", "model-context-protocol", "ai-agent", "puppeteer", "claude", "llm-tools"],
  "license": "FSL-1.1-ALv2",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "sutradhar": "dist/cli-bin.js",
    "sutradhar-mcp": "dist/mcp-cli.js"
  },
  "files": ["dist", "README.md", "LICENSE", "AGENT_SETUP.md"],
  "sideEffects": false,
  "engines": { "node": ">=18.0.0" },
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsc --emitDeclarationOnly && node ../../scripts/build-bundle.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --ext .ts",
    "test": "vitest run --globals",
    "clean": "rimraf dist",
    "prepublishOnly": "node ../../scripts/check-release-ready.mjs",
    "postpack": "node ../../scripts/record-release-shasum.mjs"
  },
  "dependencies": {
    "puppeteer-core": "^25.5.0"
  },
  "devDependencies": {
    "@sutradhar/capability-runtime": "workspace:*",
    "@types/node": "^20.11.0",
    "typescript": "5.4.2"
  }
}
