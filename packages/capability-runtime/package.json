{
  "name": "@pinchtab/capability-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Framework-agnostic high-level façade over the PinchTab browser engine. The single entry point every integration surface (MCP server, npm SDK, plugins, extension) calls.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --ext .ts",
    "test": "vitest run --globals",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@pinchtab/contracts": "workspace:*",
    "@pinchtab/utils": "workspace:*",
    "@pinchtab/observability": "workspace:*",
    "@pinchtab/events": "workspace:*",
    "@pinchtab/browser": "workspace:*",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "typescript": "5.4.2",
    "@types/pngjs": "^6.0.5"
  }
}
