{
  "name": "@sutradhar/mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Model Context Protocol server exposing Sutradhar's browser engine and autonomous agent as tools for AI clients (Claude Desktop, ZCode, Cline, etc.).",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "sutradhar-mcp": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --ext .ts",
    "start": "node dist/cli.js",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@sutradhar/agent": "workspace:*",
    "@sutradhar/browser": "workspace:*",
    "@sutradhar/capability-runtime": "workspace:*",
    "@sutradhar/config": "workspace:*",
    "@sutradhar/contracts": "workspace:*",
    "@sutradhar/events": "workspace:*",
    "@sutradhar/llm": "workspace:*",
    "@sutradhar/observability": "workspace:*",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "5.4.2"
  }
}
